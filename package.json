{
  "name": "pdfjs-react-reader",
  "version": "0.5.0",
  "description": "MIT-licensed, headless-first PDF viewer for React built directly on pdfjs-dist. Virtualized rendering, text layer, search, forms, and an optional drop-in UI shell.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princegoel0/pdfjs-react-reader.git"
  },
  "bugs": {
    "url": "https://github.com/princegoel0/pdfjs-react-reader/issues"
  },
  "homepage": "https://princegoel0.github.io/pdfjs-react-reader/",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./features/print": {
      "types": "./dist/features/print.d.ts",
      "import": "./dist/features/print.js"
    },
    "./features/download": {
      "types": "./dist/features/download.d.ts",
      "import": "./dist/features/download.js"
    },
    "./features/forms": {
      "types": "./dist/features/forms.d.ts",
      "import": "./dist/features/forms.js"
    },
    "./features/outline": {
      "types": "./dist/features/outline.d.ts",
      "import": "./dist/features/outline.js"
    },
    "./features/layers": {
      "types": "./dist/features/layers.d.ts",
      "import": "./dist/features/layers.js"
    },
    "./features/attachments": {
      "types": "./dist/features/attachments.d.ts",
      "import": "./dist/features/attachments.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./print.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/print.css"
    },
    "./forms.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/forms.css"
    },
    "./outline.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/outline.css"
    },
    "./layers.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/layers.css"
    },
    "./attachments.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/attachments.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "dev": "vite playground",
    "docs": "vite docs",
    "build:docs": "vite build docs",
    "preview:docs": "vite preview docs --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "size:update": "node scripts/check-size.mjs --update",
    "verify": "npm run typecheck && npm run test && npm run build && npm run size",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Prince Goel",
  "peerDependencies": {
    "pdfjs-dist": "^5.0.0 || ^6.2.108",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "pdf",
    "pdfjs",
    "pdfjs-dist",
    "react",
    "viewer",
    "virtualized"
  ]
}
